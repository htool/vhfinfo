        "vhfdata": {
          "generic": {
            "mode": "report",
            "note": "Franco-Italian Bonifacio Strait VTS from La Maddalena (IT) and Pertusato (FR); callsign BONIFACIO TRAFFIC. Mandatory for vessels ≥300 GT; monitor CH 10 and CH 16. IMO A.766(18) discourages laden tankers and ships with dangerous chemicals in bulk. Polygon is the two-way route (official TSS ends); west lines also join Cap de Feno and Capo Testa, east lines Pointe de Rondinara and Punta Galera."
          }
        }
